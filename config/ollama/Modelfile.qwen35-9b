# Профиль уже скачанной Qwen3.5 9B для коротких структурированных ответов MLChat.
FROM qwen3.5:9b
PARAMETER num_ctx 8192
PARAMETER num_predict 512
PARAMETER temperature 0
PARAMETER top_p 0.8
PARAMETER top_k 20
PARAMETER min_p 0
# Повторение ключей и названий полей в JSON допустимо.
PARAMETER repeat_penalty 1
PARAMETER presence_penalty 0
PARAMETER frequency_penalty 0
# В /v1 отключение thinking и temperature/top_p обеспечивает фабрика
# mlchat.integration:create_qwen35_9b_dialogue; PARAMETER think не существует.
